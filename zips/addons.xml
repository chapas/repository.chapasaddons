<?xml version='1.0' encoding='UTF-8' standalone='yes'?>
<addons>
<addon id="repository.chapasaddons" name="chapas Addons Repository" version="1.0.0" provider-name="chapas">
  <extension point="xbmc.addon.repository" name="chapas Addons">
	<dir>
	  <info compressed="false">https://raw.githubusercontent.com/chapas/repository.chapasaddons/main/zips/addons.xml</info>
	  <checksum>https://raw.githubusercontent.com/chapas/repository.chapasaddons/main/zips/addons.xml.md5</checksum>
	  <datadir zip="true">https://raw.githubusercontent.com/chapas/repository.chapasaddons/main/zips/</datadir>
	</dir>
  </extension>
  <extension point="xbmc.addon.metadata">
	<summary lang="en">chapas Kodi addons repository</summary>
	<description lang="en">Kodi addons by chapas, including AI Subtitle.</description>
	<platform>all</platform>
	<license>GPL-3.0-only</license>
	<source>https://github.com/chapas/repository.chapasaddons</source>
  </extension>
</addon>
<addon id="service.subtitles.aisubtitle" name="AI Subtitle" version="0.5.40" provider-name="AI Subtitle">
  <requires>
	<import addon="xbmc.python" version="3.0.0"/>
  </requires>
  <extension point="xbmc.subtitle.module" library="service.py"/>
  <extension point="xbmc.python.script" library="configure.py">
    <provides>executable</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
	<summary lang="en_GB">Translate the current subtitle with an OpenAI compatible API</summary>
	<description lang="en_GB">Picks up the subtitle available for the playing video and translates it to the language configured in the add-on settings using any OpenAI compatible API (bring your own key).</description>
	<platform>all</platform>
	<license>MIT</license>
  </extension>
</addon>
</addons>
